# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local

# vercel
.vercel

# local admin credential hash (never commit or ship in ZIP)
/content/admin-auth.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Local dev fallback stores (never commit; MongoDB is the real source)
/content/sections.dev.json
/content/assets.dev.json
/content/*.backup.json
.env.local
